# Copier ce fichier en .env puis adapter si besoin.

# Serveur de la boutique
HOST=127.0.0.1
PORT=3000

# API Strapi (catalogue). URL de base, sans /api.
STRAPI_URL=http://localhost:1337
# Facultatif : jeton d'API Strapi (Settings > API Tokens, type "Read-only").
# Inutile tant que le rôle Public a la permission Article > find.
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_MS=6000
CATALOGUE_CACHE_MS=10000

# Base SQLite des comptes clients, sessions, paniers et commandes
DB_PATH=data/gameshop.db
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Passer à true derrière HTTPS
COOKIE_SECURE=false

# Compte de démonstration (créé au démarrage s'il n'existe pas)
DEMO_EMAIL=demo@gameshop.test
DEMO_PASSWORD=Console2026!
DEMO_NAME="Alex Martin"
SHOW_DEMO_ACCOUNT=true

# Inscriptions : maximum par heure et par adresse IP
REGISTER_MAX_PER_HOUR=10
